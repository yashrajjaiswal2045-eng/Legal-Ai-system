# Copy this file to .env and fill it in. Never commit .env.
# Leave LLM_API_KEY empty to run in demo mode (mock answers, no external calls).
LLM_API_KEY=
# Any OpenAI-compatible endpoint, e.g. https://api.openai.com/v1
LLM_BASE_URL=
LLM_MODEL=
# Optional: comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
